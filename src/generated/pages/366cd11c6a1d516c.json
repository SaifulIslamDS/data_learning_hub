utorials/data-foundations/data-quality-dimensions/\"><span>13</span><span data-bn=\"Data Quality Dimension\" data-en=\"Data Quality Dimensions\">Data Quality Dimensions</span><b aria-hidden=\"true\" class=\"chapter-state\">○</b></a><a class=\"tutorial-chapter-link\" data-chapter-link=\"missing-duplicate-invalid-and-outlier-values\" href=\"/tutorials/data-foundations/missing-duplicate-invalid-and-outlier-values/\"><span>14</span><span data-bn=\"Missing, Duplicate, Invalid ও Outlier Value\" data-en=\"Missing, Duplicate, Invalid, and Outlier Values\">Missing, Duplicate, Invalid, and Outlier Values</span><b aria-hidden=\"true\" class=\"chapter-state\">○</b></a><a class=\"tutorial-chapter-link current\" data-chapter-link=\"tidy-data-and-organization\" href=\"/tutorials/data-foundations/tidy-data-and-organization/\"><span>15</span><span data-bn=\"Tidy Data ও Data Organization\" data-en=\"Tidy Data and Data Organization\">Tidy Data and Data Organization</span><b aria-hidden=\"true\" class=\"chapter-state\">○</b></a><a class=\"tutorial-chapter-link\" data-chapter-link=\"frequency-tables-and-summary-views\" href=\"/tutorials/data-foundations/frequency-tables-and-summary-views/\"><span>16</span><span data-bn=\"Frequency Table ও Summary View\" data-en=\"Frequency Tables and Summary Views\">Frequency Tables and Summary Views</span><b aria-hidden=\"true\" class=\"chapter-state\">○</b></a><a class=\"tutorial-chapter-link\" data-chapter-link=\"analytical-questions-and-metrics\" href=\"/tutorials/data-foundations/analytical-questions-and-metrics/\"><span>17</span><span data-bn=\"Analytical Question ও Metric Definition\" data-en=\"Analytical Questions and Defining Metrics\">Analytical Questions and Defining Metrics</span><b aria-hidden=\"true\" class=\"chapter-state\">○</b></a><a class=\"tutorial-chapter-link\" data-chapter-link=\"exploratory-data-analysis-workflow\" href=\"/tutorials/data-foundations/exploratory-data-analysis-workflow/\"><span>18</span><span data-bn=\"Exploratory Data Analysis Workflow\" data-en=\"Exploratory Data Analysis Workflow\">Exploratory Data Analysis Workflow</span><b aria-hidden=\"true\" class=\"chapter-state\">○</b></a><a class=\"tutorial-chapter-link\" data-chapter-link=\"reproducible-analysis-and-documentation\" href=\"/tutorials/data-foundations/reproducible-analysis-and-documentation/\"><span>19</span><span data-bn=\"Reproducible Analysis ও Documentation\" data-en=\"Reproducible Analysis and Documentation\">Reproducible Analysis and Documentation</span><b aria-hidden=\"true\" class=\"chapter-state\">○</b></a><a class=\"tutorial-chapter-link\" data-chapter-link=\"data-ethics-privacy-and-responsible-use\" href=\"/tutorials/data-foundations/data-ethics-privacy-and-responsible-use/\"><span>20</span><span data-bn=\"Data Ethics, Privacy ও Responsible Use\" data-en=\"Data Ethics, Privacy, and Responsible Use\">Data Ethics, Privacy, and Responsible Use</span><b aria-hidden=\"true\" class=\"chapter-state\">○</b></a><a class=\"tutorial-chapter-link\" data-chapter-link=\"mini-project-retail-data-audit\" href=\"/tutorials/data-foundations/mini-project-retail-data-audit/\"><span>21</span><span data-bn=\"Mini Project: Retail Dataset Audit\" data-en=\"Mini Project: Audit a Retail Dataset\">Mini Project: Audit a Retail Dataset</span><b aria-hidden=\"true\" class=\"chapter-state\">○</b></a></div></nav>\n<div class=\"tutorial-sidebar-links\"><a href=\"/exercises/data-foundations/\">Exercises</a><a href=\"/quiz/data-foundations/\">Final quiz</a><a href=\"/examples/data-foundations/\">Examples</a><a href=\"/references/data-foundations/\">References</a></div>\n</aside>\n<div class=\"tutorial-drawer-backdrop\" id=\"tutorial-drawer-backdrop\"></div>\n<article class=\"tutorial-content\" data-chapter=\"tidy-data-and-organization\" data-tutorial=\"data-foundations\">\n<header class=\"tutorial-page-header\"><div>\n<span class=\"eyebrow\" data-bn=\"Data Foundations · Chapter 15 / 21\" data-en=\"Data Foundations · Chapter 15 of 21\">Data Foundations · Chapter 15 of 21</span>\n<h1 data-bn=\"Tidy Data ও Data Organization\" data-en=\"Tidy Data and Data Organization\">Tidy Data and Data Organization</h1>\n<p class=\"tutorial-lead\" data-bn=\"Analytical data এমনভাবে organize করুন যাতে প্রতিটি variable একটি column, প্রতিটি observation একটি row এবং প্রতিটি observational unit type একটি table পায়। এতে manual work ও error কেন কমে শিখুন।\" data-en=\"Organize analytical data so each variable has a column, each observation has a row, and each type of observational unit has a table. Learn why this reduces manual work and errors.\">Organize analytical data so each variable has a column, each observation has a row, and each type of observational unit has a table. Learn why this reduces manual work and errors.</p>\n</div><div class=\"tutorial-header-actions\"><button class=\"button ghost tutorial-drawer-open\" id=\"tutorial-drawer-open\" type=\"button\">☰ <span data-bn=\"Chapter\" data-en=\"Chapters\">Chapters</span></button><button class=\"button ghost\" onclick=\"window.print()\" type=\"button\">⎙ <span data-bn=\"Print\" data-en=\"Print\">Print</span></button></div></header>\n<div class=\"chapter-meta\"><span>◷ 45 min</span><span>Beginner</span><button class=\"button small primary\" id=\"chapter-complete\" type=\"button\">Mark complete</button></div>\n<nav aria-label=\"On this chapter\" class=\"chapter-jump\"><a href=\"#objectives\">Objectives</a><a href=\"#concept-1\">Learn</a><a href=\"#worked-example\">Example</a><a href=\"#try-it\">Try it</a><a href=\"#exercises\">Exercises</a><a href=\"#summary\">Summary</a></nav>\n<section class=\"tutorial-section tutorial-objectives\" id=\"objectives\"><div class=\"section-kicker\">Start here</div><h2 data-bn=\"আপনি যা শিখবেন\" data-en=\"What you will learn\">What you will learn</h2><ul><li><span data-bn=\"Core tidy-data principle বলুন।\" data-en=\"State the core tidy-data principles.\">State the core tidy-data principles.</span></li><li><span data-bn=\"Common untidy layout চিনুন।\" data-en=\"Recognize common untidy layouts.\">Recognize common untidy layouts.</span></li><li><span data-bn=\"Wide repeated measure-কে long form-এ reshape করুন।\" data-en=\"Reshape wide repeated measures into long form.\">Reshape wide repeated measures into long form.</span></li><li><span data-bn=\"Multiple observational unit আলাদা করুন।\" data-en=\"Separate multiple observational units.\">Separate multiple observational units.</span></li></ul></section>\n<section class=\"tutorial-section\" id=\"concept-1\"><div class=\"section-kicker\">01</div><h2 data-bn=\"Tidy structure\" data-en=\"Tidy structure\">Tidy structure</h2><p data-bn=\"Tidy analytical table-এ প্রতি variable এক column, প্রতি observation এক row এবং প্রতি observational unit এক table। এতে operation predictable হয়: row filter, column select, category group এবং numerical field summarize।\" data-en=\"A tidy analytical table uses one column per variable, one row per observation, and one table per observational unit. This convention makes operations predictable: filter rows, select columns, group by categories, and summarize numerical fields.\">A tidy analytical table uses one column per variable, one row per observation, and one table per observational unit. This convention makes operations predictable: filter rows, select columns, group by categories, and summarize numerical fields.</p></section><section class=\"tutorial-section\" id=\"concept-2\"><div class=\"section-kicker\">02</div><h2 data-bn=\"Common untidy pattern\" data-en=\"Common untidy patterns\">Common untidy patterns</h2><p data-bn=\"Common problem: header-এ variable name value হিসেবে, এক column-এ multiple variable, এক observation multiple row-এ, repeated block এবং এক table-এ multiple unit mix। Presentation report analysis-এর আগে reshape প্রয়োজন।\" data-en=\"Common problems include variable names stored as values in headers, multiple variables combined in one column, one observation spread across several rows, repeated blocks, and several units mixed in one table. Presentation reports often need reshaping before analysis.\">Common problems include variable names stored as values in headers, multiple variables combined in one column, one observation spread across several rows, repeated blocks, and several units mixed in one table. Presentation reports often need reshaping before analysis.</p></section><section class=\"tutorial-section\" id=\"concept-3\"><div class=\"section-kicker\">03</div><h2 data-bn=\"Long ও wide transformation\" data-en=\"Long and wide transformations\">Long and wide transformations</h2><p data-bn=\"Pivot longer repeated column header-কে variable-এ নেয়; pivot wider category value-কে presentation বা matrix-এর জন্য column-এ spread করে। কোনো shape universally best নয়, তবে tidy long form reliable analysis base।\" data-en=\"Pivoting longer moves repeated column headers into a variable; pivoting wider spreads category values into columns for a specific presentation or matrix. Neither shape is universally best, but tidy long form is often a reliable storage and analysis base.\">Pivoting longer moves repeated column headers into a variable; pivoting wider spreads category values into columns for a specific presentation or matrix. Neither shape is universally best, but tidy long form is often a reliable storage and analysis base.</p></section><section class=\"tutorial-section\" id=\"concept-4\"><div class=\"section-kicker\">04</div><h2 data-bn=\"Entity ও event আলাদা করুন\" data-en=\"Separate entities and events\">Separate entities and events</h2><p data-bn=\"Customer, order, product ও order line different observational unit। Flat file-এ customer detail repeat practical হতে পারে, কিন্তু double counting এড়াতে key ও relationship বুঝতে হবে।\" data-en=\"Customers, orders, products, and order lines are different observational units. Repeating customer details on every order may be practical in a flat file, but relational analysis should understand keys and relationships to avoid double counting.\">Customers, orders, products, and order lines are different observational units. Repeating customer details on every order may be practical in a flat file, but relational analysis should understand keys and relationships to avoid double counting.</p></section>\n<section class=\"tutorial-section key-terms\" id=\"key-terms\"><div class=\"section-kicker\">Vocabulary</div><h2 data-bn=\"গুরুত্বপূর্ণ শব্দ\" data-en=\"Key terms\">Key terms</h2><div class=\"term-grid\"><article class=\"term-card\"><h3 data-bn=\"Tidy data\" data-en=\"Tidy data\">Tidy data</h3><p data-bn=\"Variable column ও observation row-এ থাকা consistent structure।\" data-en=\"A consistent structure with variables in columns and observations in rows.\">A consistent structure with variables in columns and observations in rows.</p></article><article class=\"term-card\"><h3 data-bn=\"Pivot longer\" data-en=\"Pivot longer\">Pivot longer</h3><p data-bn=\"Repeated measure column-কে variable-value row-এ transform করা।\" data-en=\"Transform repeated measure columns into variable-value rows.\">Transform repeated measure columns into variable-value rows.</p></article><article class=\"term-card\"><h3 data-bn=\"Pivot wider\" data-en=\"Pivot wider\">Pivot wider</h3><p data-bn=\"Category value-কে separate column-এ spread করা।\" data-en=\"Spread category values into separate columns.\">Spread category values into separate columns.</p></article><article class=\"term-card\"><h3 data-bn=\"Observational unit\" data-en=\"Observational unit\">Observational unit</h3><p data-bn=\"এক row দ্বারা represented entity বা event।\" data-en=\"The entity or event represented by one row.\">The entity or event represented by one row.</p></article></div></section>\n<section class=\"tutorial-section worked-example\" id=\"worked-example\">\n<div class=\"section-kicker\">Example</div><h2 data-bn=\"Monthly branch sales reshape\" data-en=\"Reshaping monthly branch sales\">Reshaping monthly branch sales</h2><p class=\"example-context\" data-bn=\"Sheet-এ branch, Jan_sales, Feb_sales ও Mar_sales column আছে।\" data-en=\"A sheet has columns branch, Jan_sales, Feb_sales, and Mar_sales.\">A sheet has columns branch, Jan_sales, Feb_sales, and Mar_sales.</p>\n<ol class=\"worked-steps\"><li><span>1</span><p data-bn=\"Repeated month name column header-এ stored value।\" data-en=\"The repeated month names are values stored in column headers.\">The repeated month names are values stored in column headers.</p></li><li><span>2</span><p data-bn=\"Branch identifier variable রাখুন।\" data-en=\"Keep branch as an identifier variable.\">Keep branch as an identifier variable.</p></li><li><span>3</span><p data-bn=\"Month column তৈরি করুন।\" data-en=\"Create a month column.\">Create a month column.</p></li><li><span>4</span><p data-bn=\"Sales column তৈরি করুন।\" data-en=\"Create a sales column.\">Create a sales column.</p></li><li><span>5</span><p data-bn=\"প্রতিটি branch-month একটি observation হবে।\" data-en=\"Each branch-month becomes one observation.\">Each branch-month becomes one observation.</p></li></ol>\n<div class=\"example-conclusion\"><strong data-bn=\"Conclusion\" data-en=\"Conclusion\">Conclusion</strong><p data-bn=\"Long table-এ analysis formula বা chart design না বদলে new month add করা যায়।\" data-en=\"The long table can accept new months without changing the analysis formula or chart design.\">The long table can accept new months without changing the analysis formula or chart design.</p></div>\n</section>\n<section class=\"tutorial-section try-it-section\" id=\"try-it\"><div class=\"section-kicker\">Try it yourself</div><h2 data-bn=\"ধারণাটি প্র্যাকটিস করুন\" data-en=\"Practice the idea\">Practice the idea</h2><div id=\"tutorial-activity\"></div></section>\n<section class=\"tutorial-section exercise-section\" id=\"exercises\"><div class=\"section-kicker\">Check yourself</div><h2 data-bn=\"Chapter exercise\" data-en=\"Chapter exercises\">Chapter exercises</h2><div id=\"chapter-exercises\"></div><a class=\"text-link\" href=\"/exercises/data-foundations/\">Open the complete exercise library →</a></section>\n<section class=\"tutorial-section recap-section\" id=\"summary\"><div class=\"section-kicker\">Summary</div><h2 data-bn=\"যা মনে রাখবেন\" data-en=\"What to remember\">What to remember</h2><ul><li><span data-bn=\"প্রতি variable এক column।\" data-en=\"One variable per column.\">One variable per column.</span></li><li><span data-bn=\"প্রতি observation এক row।\" data-en=\"One observation per row.\">One observation per row.</span></li><li><span data-bn=\"প্রতি observational unit এক table।\" data-en=\"One observational unit per table.\">One observational unit per table.</span></li><li><span data-bn=\"Analysis-এর আগে presentation layout reshape করুন।\" data-en=\"Reshape presentation layouts before analysis.\">Reshape presentation layouts before analysis.</span></li></ul></section>\n<details class=\"tutorial-references\"><summary>Authoritative references</summary><ul><li><a href=\"https://nvlpubs.nist.gov/nistpubs/SpecialPublications/1500-18/NIST.SP.1500-18r2.html\" rel=\"noopener noreferrer\" target=\"_blank\">NIST Research Data Framework ↗</a></li><li><a href=\"https://ukdataservice.ac.uk/help/new-users/data-documentation/\" rel=\"noopener noreferrer\" target=\"_blank\">UK Data Service — Data Documentation ↗</a></li></ul></details>\n<div class=\"tutorial-complete-panel\"><div><h2 data-bn=\"পরবর্তী chapter-এর জন্য প্রস্তুত?\" data-en=\"Ready for the next chapter?\">Ready for the next chapter?</h2><p data-bn=\"ধারণাটি explain ও exercise finish করতে পারলে chapter complete mark করুন।\" data-en=\"Mark this chapter complete after you can explain the idea and finish the exercises.\">Mark this chapter complete after you can explain the idea and finish the exercises.</p></div><button class=\"button primary\" id=\"chapter-complete-bottom\" type=\"button\">Mark complete</button></div>\n<nav class=\"tutorial-pager\"><a class=\"tutorial-prev\" href=\"/tutorials/data-foundations/missing-duplicate-invalid-and-outlier-values/\"><small>← Previous</small><strong data-bn=\"Missing, Duplicate, Invalid ও Outlier Value\" data-en=\"Missing, Duplicate, Invalid, and Outlier Values\">Missing, Duplicate, Invalid, and Outlier Values</strong></a><a class=\"tutorial-next\" href=\"/tutorials/data-foundations/frequency-tables-and-summary-views/\"><small>Next →</small><strong data-bn=\"Frequency Table ও Summary View\" data-en=\"Frequency Tables and Summary Views\">Frequency Tables and Summary Views</strong></a></nav>\n</article>\n</div></main>","scripts":["/assets/js/tutorial-core.js","/assets/js/tutorial.js"],"inlineScripts":[]}